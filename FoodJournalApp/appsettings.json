{
  "ConnectionStrings": {
    "Default": "REPLACE_VIA_USER_SECRETS (env: ConnectionStrings__Default or DATABASE_URL). Format: Host=localhost;Port=5432;Database=foodjournal;Username=postgres;Password=..."
  },
  "Anthropic": {
    "ApiKey": "REPLACE_VIA_USER_SECRETS (env: Anthropic__ApiKey)"
  },
  "Jwt": {
    "Key": "REPLACE_VIA_USER_SECRETS (env: Jwt__Key)",
    "Issuer": "FoodJournalApp",
    "Audience": "FoodJournalApp",
    "ExpiryMinutes": "60"
  },
  "PhotoStorage": {
    "Provider": "R2"
  },
  "R2": {
    "ServiceUrl": "REPLACE_VIA_USER_SECRETS (env: R2__ServiceUrl). Format: https://<accountid>.r2.cloudflarestorage.com",
    "AccessKeyId": "REPLACE_VIA_USER_SECRETS (env: R2__AccessKeyId)",
    "SecretAccessKey": "REPLACE_VIA_USER_SECRETS (env: R2__SecretAccessKey)",
    "BucketName": "REPLACE_VIA_USER_SECRETS (env: R2__BucketName)",
    "PublicBaseUrl": "REPLACE_VIA_USER_SECRETS (env: R2__PublicBaseUrl). Format: https://pub-<hash>.r2.dev",
    "KeyPrefix": "meals/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
